// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model Archive {
  selfId      Uuid     @id(map: "Archive_pkey") @default(dbgenerated("gen_random_uuid()"))
  performanceId Uuid?
  title       String
  genre       String?
  director    String?
  description String?
  duration    Int
  rating      String
  image       String
  mainPhoto   String?
  videos      String[] @default([]) @noCheck(elementNotNull)
  photos      String[] @default([]) @noCheck(elementNotNull)
  actors      ArchiveActor[]
  events      ArchiveEvent[]
  performance Performance @relation(fields: [performanceId], references: [selfId], onDelete: Cascade, onUpdate: Cascade, map: "Archive_performanceId_fkey")
}

model Performance {
  selfId      Uuid    @id(map: "Performance_pkey") @default(dbgenerated("gen_random_uuid()"))
  archiveId   Uuid?
  title       String
  genre       String?
  director    String?
  description String?
  duration    Int
  rating      String
  image       String
  events      Event[]
  archive    Archive @relation(fields: [archiveId], references: [selfId], onDelete: SetNull, onUpdate: Cascade, map: "Performance_archiveId_fkey")
}

model Event {
  selfId        Uuid           @id(map: "Event_pkey") @default(dbgenerated("gen_random_uuid()"))
  performanceId Uuid
  activeState   Boolean        @default(true)
  scene         String
  date          TimestampString(0)
  registrations Registration[]
  performance   Performance    @relation(fields: [performanceId], references: [selfId], onDelete: Cascade, onUpdate: Cascade, map: "Event_performanceId_fkey")

  @@index([performanceId], map: "Event_performanceId_idx")
}

model Person {
  selfId      Uuid    @id(map: "Person_pkey") @default(dbgenerated("gen_random_uuid()"))
  orderNo     Int     @default(autoincrement())
  contactInfo String?
  isActive    Boolean @default(true)
  name        String
  role        String?
  image       String
  archiveActors ArchiveActor[]
}

model ArchiveActor {
  archiveId Uuid
  personId  Uuid
  archive   Archive @relation(fields: [archiveId], references: [selfId], onDelete: Cascade, onUpdate: Cascade, map: "ArchiveActor_archiveId_fkey")
  person    Person  @relation(fields: [personId], references: [selfId], onDelete: Cascade, onUpdate: Cascade, map: "ArchiveActor_personId_fkey")

  @@id([archiveId, personId], map: "ArchiveActor_pkey")
  @@index([personId], map: "ArchiveActor_personId_idx")
}

model ArchiveEvent {
  selfId        Uuid           @id(map: "ArchiveEvent") @default(dbgenerated("gen_random_uuid()"))
  archiveId     Uuid
  scene         String
  date          TimestampString(0)
  archive       Archive    @relation(fields: [archiveId], references: [selfId], onDelete: Cascade, onUpdate: Cascade, map: "ArchiveEvent_archiveId_fkey")

  @@index([archiveId], map: "ArchiveEvent_archiveId_idx")
}

model Registration {
  selfId      Uuid    @id(map: "Registration_pkey") @default(dbgenerated("gen_random_uuid()"))
  eventId     Uuid
  name        String
  surname     String
  middleName  String?
  email       String?
  phoneNumber String?
  event       Event   @relation(fields: [eventId], references: [selfId], onDelete: Cascade, onUpdate: Cascade, map: "Registration_eventId_fkey")

  @@index([eventId], map: "Registration_eventId_idx")
}

model Supervisor {
  selfId      Uuid    @id(map: "Supervisor_pkey") @default(dbgenerated("gen_random_uuid()"))
  orderNo     Int     @default(autoincrement())
  name        String  @unique(map: "Supervisor_name_key")
  role        String?
  contactInfo String?
  image       String?
}
